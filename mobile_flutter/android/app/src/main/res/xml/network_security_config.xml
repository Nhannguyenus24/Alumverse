<?xml version="1.0" encoding="utf-8"?>
<!--
  Cho phép HTTP (cleartext) tới backend dev chạy trên máy host.
  - 10.0.2.2  : host machine nhìn từ Android emulator (backend :8080, nginx :80)
  - localhost : khi chạy trên Windows desktop/web
  Production dùng HTTPS thì không cần các domain này.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
    </domain-config>
</network-security-config>
