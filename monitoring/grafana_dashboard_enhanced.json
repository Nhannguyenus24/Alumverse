{
  "dashboard": {
    "title": "Alumniverse Backend - Endpoint Latency & Performance",
    "timezone": "browser",
    "refresh": "5s",
    "schemaVersion": 38,
    "version": 2,
    "panels": [
      {
        "type": "row",
        "title": "📊 Endpoint Performance Overview",
        "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
        "collapsed": false
      },
      {
        "type": "stat",
        "title": "Total API Requests (All Time)",
        "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
        "targets": [
          {
            "expr": "sum(http_endpoint_requests_total)",
            "legendFormat": "Total Requests",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "color": { "mode": "palette-classic" }
          }
        }
      },
      {
        "type": "stat",
        "title": "API Errors (All Time)",
        "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
        "targets": [
          {
            "expr": "sum(http_endpoint_errors_total)",
            "legendFormat": "Total Errors",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "orange", "value": 10 },
                { "color": "red", "value": 100 }
              ]
            }
          }
        }
      },
      {
        "type": "stat",
        "title": "Error Rate",
        "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
        "targets": [
          {
            "expr": "(sum(http_endpoint_errors_total) / sum(http_endpoint_requests_total)) * 100",
            "legendFormat": "Error %",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "orange", "value": 1 },
                { "color": "red", "value": 5 }
              ]
            }
          }
        }
      },
      {
        "type": "stat",
        "title": "Avg Latency (All Endpoints)",
        "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
        "targets": [
          {
            "expr": "sum(rate(http_endpoint_latency_seconds_sum[5m])) / sum(rate(http_endpoint_latency_seconds_count[5m]))",
            "legendFormat": "Avg Latency",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ms",
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "orange", "value": 500 },
                { "color": "red", "value": 1000 }
              ]
            }
          }
        }
      },
      {
        "type": "row",
        "title": "⚡ Latency Metrics",
        "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
        "collapsed": false
      },
      {
        "type": "timeseries",
        "title": "Average Latency by Endpoint (5min avg)",
        "gridPos": { "h": 10, "w": 12, "x": 0, "y": 6 },
        "targets": [
          {
            "expr": "sum by (path) (rate(http_endpoint_latency_seconds_sum[5m])) / sum by (path) (rate(http_endpoint_latency_seconds_count[5m])) * 1000",
            "legendFormat": "{{path}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ms",
            "custom": {
              "lineWidth": 2,
              "fillOpacity": 10
            }
          }
        },
        "options": {
          "legend": {
            "displayMode": "table",
            "placement": "right",
            "showLegend": true,
            "calcs": ["mean", "max", "min", "last"]
          }
        }
      },
      {
        "type": "timeseries",
        "title": "P99 Latency by Endpoint",
        "gridPos": { "h": 10, "w": 12, "x": 12, "y": 6 },
        "targets": [
          {
            "expr": "histogram_quantile(0.99, sum(rate(http_endpoint_latency_seconds_bucket[5m])) by (le, path)) * 1000",
            "legendFormat": "p99 - {{path}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ms",
            "custom": {
              "lineWidth": 2,
              "fillOpacity": 10
            },
            "color": {
              "mode": "palette-classic"
            }
          }
        },
        "options": {
          "legend": {
            "displayMode": "table",
            "placement": "right",
            "showLegend": true,
            "calcs": ["mean", "max", "min", "last"]
          }
        }
      },
      {
        "type": "timeseries",
        "title": "P95 Latency by Endpoint",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(http_endpoint_latency_seconds_bucket[5m])) by (le, path)) * 1000",
            "legendFormat": "p95 - {{path}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ms",
            "custom": {
              "lineWidth": 1,
              "fillOpacity": 5
            }
          }
        }
      },
      {
        "type": "timeseries",
        "title": "P50 Latency by Endpoint (Median)",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
        "targets": [
          {
            "expr": "histogram_quantile(0.50, sum(rate(http_endpoint_latency_seconds_bucket[5m])) by (le, path)) * 1000",
            "legendFormat": "p50 - {{path}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ms",
            "custom": {
              "lineWidth": 1,
              "fillOpacity": 5
            }
          }
        }
      },
      {
        "type": "row",
        "title": "📈 Request & Error Metrics",
        "gridPos": { "h": 1, "w": 24, "x": 0, "y": 24 },
        "collapsed": false
      },
      {
        "type": "timeseries",
        "title": "Requests per Second by Endpoint",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 25 },
        "targets": [
          {
            "expr": "sum by (path, method, status) (rate(http_endpoint_requests_total[1m])) > 0",
            "legendFormat": "{{method}} {{path}} - {{status}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "reqps",
            "custom": {
              "lineWidth": 1,
              "fillOpacity": 10
            }
          }
        },
        "options": {
          "legend": {
            "displayMode": "table",
            "placement": "bottom",
            "showLegend": true,
            "calcs": ["mean", "max"]
          }
        }
      },
      {
        "type": "timeseries",
        "title": "Error Rate by Endpoint",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 25 },
        "targets": [
          {
            "expr": "sum by (path, status) (rate(http_endpoint_errors_total[5m])) > 0",
            "legendFormat": "{{path}} - {{status}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ops",
            "custom": {
              "lineWidth": 2,
              "fillOpacity": 20
            },
            "color": {
              "mode": "palette-classic"
            }
          }
        }
      },
      {
        "type": "row",
        "title": "🔴 Top 10 Slowest Endpoints (Latest)",
        "gridPos": { "h": 1, "w": 24, "x": 0, "y": 33 },
        "collapsed": false
      },
      {
        "type": "table",
        "title": "Slowest Endpoints (by Avg Latency)",
        "gridPos": { "h": 8, "w": 24, "x": 0, "y": 34 },
        "targets": [
          {
            "expr": "topk(10, sum by (path, method) (rate(http_endpoint_latency_seconds_sum[5m])) / sum by (path, method) (rate(http_endpoint_latency_seconds_count[5m])) * 1000)",
            "format": "table",
            "instant": true,
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ms",
            "custom": {
              "width": 150
            }
          },
          "overrides": [
            {
              "matcher": { "id": "byName", "options": "Value" },
              "properties": [
                {
                  "id": "unit",
                  "value": "ms"
                },
                {
                  "id": "custom.width",
                  "value": 150
                },
                {
                  "id": "color",
                  "value": {
                    "mode": "thresholds"
                  }
                },
                {
                  "id": "thresholds",
                  "value": {
                    "mode": "absolute",
                    "steps": [
                      { "color": "green", "value": null },
                      { "color": "orange", "value": 500 },
                      { "color": "red", "value": 1000 }
                    ]
                  }
                }
              ]
            }
          ]
        },
        "options": {
          "showHeader": true,
          "sortBy": [
            {
              "name": "Value",
              "displayName": "Value",
              "desc": true
            }
          ]
        }
      },
      {
        "type": "row",
        "title": "🚨 Endpoints with Errors",
        "gridPos": { "h": 1, "w": 24, "x": 0, "y": 42 },
        "collapsed": false
      },
      {
        "type": "table",
        "title": "Endpoints with Highest Error Rate",
        "gridPos": { "h": 8, "w": 24, "x": 0, "y": 43 },
        "targets": [
          {
            "expr": "topk(10, (sum by (path, status) (rate(http_endpoint_errors_total[5m])) / sum by (path) (rate(http_endpoint_requests_total[5m]))) * 100)",
            "format": "table",
            "instant": true,
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "custom": {
              "width": 150
            }
          },
          "overrides": [
            {
              "matcher": { "id": "byName", "options": "Value" },
              "properties": [
                {
                  "id": "color",
                  "value": {
                    "mode": "thresholds"
                  }
                },
                {
                  "id": "thresholds",
                  "value": {
                    "mode": "absolute",
                    "steps": [
                      { "color": "green", "value": null },
                      { "color": "orange", "value": 1 },
                      { "color": "red", "value": 5 }
                    ]
                  }
                }
              ]
            }
          ]
        }
      },
      {
        "type": "row",
        "title": "📊 System Metrics",
        "gridPos": { "h": 1, "w": 24, "x": 0, "y": 51 },
        "collapsed": false
      },
      {
        "type": "timeseries",
        "title": "CPU Usage",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 52 },
        "targets": [
          {
            "expr": "system_cpu_usage * 100",
            "legendFormat": "System CPU",
            "refId": "A"
          },
          {
            "expr": "process_cpu_usage * 100",
            "legendFormat": "JVM Process CPU",
            "refId": "B"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "custom": {
              "lineWidth": 1,
              "fillOpacity": 10
            }
          }
        }
      },
      {
        "type": "timeseries",
        "title": "JVM Heap Memory",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 52 },
        "targets": [
          {
            "expr": "sum(jvm_memory_used_bytes{area=\"heap\"}) / 1024 / 1024",
            "legendFormat": "Heap Used (MB)",
            "refId": "A"
          },
          {
            "expr": "sum(jvm_memory_max_bytes{area=\"heap\"}) / 1024 / 1024",
            "legendFormat": "Heap Max (MB)",
            "refId": "B"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "custom": {
              "lineWidth": 1,
              "fillOpacity": 10
            }
          }
        }
      },
      {
        "type": "timeseries",
        "title": "Request Count Trend",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 60 },
        "targets": [
          {
            "expr": "sum(rate(http_endpoint_requests_total[5m]))",
            "legendFormat": "RPS",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "reqps",
            "custom": {
              "lineWidth": 2,
              "fillOpacity": 10
            },
            "color": {
              "mode": "palette-classic"
            }
          }
        }
      },
      {
        "type": "timeseries",
        "title": "GC Pause Time",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 60 },
        "targets": [
          {
            "expr": "rate(jvm_gc_pause_seconds_sum[5m]) * 1000",
            "legendFormat": "GC Pause (ms)",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ms",
            "custom": {
              "lineWidth": 1
            }
          }
        }
      }
    ]
  }
}
