VITE_API_BASE_URL=https://your-api-domain.com
VITE_WS_CHAT_URL=wss://your-api-domain.com/ws/chat
VITE_FITBOT_API_URL=https://your-bot-api-domain.com
# Optional. Full URL of the SSE endpoint. When unset, it defaults to
# `${VITE_API_BASE_URL}/api/sse/connect` (connecting straight to the backend so the
# stream is not buffered by the Vercel `/api` rewrite proxy).
# VITE_SSE_URL=https://your-api-domain.com/api/sse/connect
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_site_key
# Datadog metrics (read by the Admin → System Monitoring page). The page queries
# Datadog's v1 timeseries API directly from the browser, so these are bundled into
# the client build — use a scoped/read-only Application key.
VITE_DATADOG_SITE=us5.datadoghq.com
VITE_DATADOG_API_KEY=your_datadog_api_key
# Giphy web SDK/API key (client-side key). Used by the chat GIF picker.
VITE_GIPHY_API_KEY=your_giphy_api_key
VITE_PROMETHEUS_URL=https://your-prometheus-domain.com/prometheus
