@startuml
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 15
skinparam dpi 150
skinparam shadowing false
skinparam nodesep 12
skinparam ranksep 26
skinparam wrapWidth 260
skinparam ArrowColor #4A5568
skinparam usecase {
  BackgroundColor #EAF3FB
  BorderColor #2B6CB0
  FontSize 15
}
skinparam actor {
  BackgroundColor #FFFFFF
  BorderColor #2B3A55
  FontSize 15
}
skinparam rectangle {
  BorderColor #2B3A55
  FontStyle bold
  FontSize 16
}
skinparam package {
  BackgroundColor #F7FAFC
  BorderColor #A0AEC0
  FontSize 14
  FontStyle italic
}

left to right direction
actor "Sinh viên" as AC
rectangle "Hệ thống AlumVerse 2026" {
  package "Kết nối, nhắn tin, diễn đàn và nội dung" {
    usecase "Tìm kiếm thành viên trong mạng lưới" as U0
    usecase "Gửi và phản hồi yêu cầu kết nối" as U1
    usecase "Nhắn tin cá nhân" as U2
    usecase "Nhắn tin nhóm" as U3
    usecase "Đính kèm ảnh và video" as U4
    usecase "Chặn và bỏ chặn người dùng" as U5
    usecase "Tham gia chủ đề diễn đàn nghề nghiệp" as U6
    usecase "Tìm kiếm và theo dõi chủ đề" as U7
    usecase "Tìm việc làm" as U8
    usecase "Truy cập kho học liệu" as U9
    usecase "Lưu nội dung để xem sau" as U10
    usecase "Xem chuyên trang phát triển sự nghiệp" as U11
  }
}
AC --> U0
AC --> U1
AC --> U2
AC --> U3
AC --> U5
AC --> U6
AC --> U7
AC --> U8
AC --> U9
AC --> U10
AC --> U11
U2 ..> U1 : <<include>>
U4 ..> U2 : <<extend>>
@enduml