@startuml
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 15
skinparam dpi 150
skinparam shadowing false
skinparam nodesep 12
skinparam ranksep 26
skinparam wrapWidth 260
skinparam ArrowColor #4A5568
skinparam usecase {
  BackgroundColor #EAF3FB
  BorderColor #2B6CB0
  FontSize 15
}
skinparam actor {
  BackgroundColor #FFFFFF
  BorderColor #2B3A55
  FontSize 15
}
skinparam rectangle {
  BorderColor #2B3A55
  FontStyle bold
  FontSize 16
}
skinparam package {
  BackgroundColor #F7FAFC
  BorderColor #A0AEC0
  FontSize 14
  FontStyle italic
}

left to right direction
actor "Sinh viên" as AC
rectangle "Hệ thống AlumVerse 2026" {
  package "Sự kiện, cố vấn, quỹ và trợ lý ảo" {
    usecase "Quan tâm và đăng ký tham dự sự kiện" as U0
    usecase "Nhận vé điện tử" as U1
    usecase "Xem vé của tôi" as U2
    usecase "Đăng ký làm người được cố vấn" as U3
    usecase "Tìm kiếm và ghép cặp người cố vấn" as U4
    usecase "Đặt lịch buổi cố vấn" as U5
    usecase "Kiểm tra khung giờ còn trống" as U6
    usecase "Tham gia buổi cố vấn qua phòng họp trực tuyến" as U7
    usecase "Đánh giá và phản hồi sau buổi" as U8
    usecase "Báo cáo sự cố buổi cố vấn" as U9
    usecase "Đóng góp cho quỹ của đơn vị" as U10
    usecase "Trả lời khảo sát" as U11
    usecase "Hỏi đáp với trợ lý ảo" as U12
  }
}
AC --> U0
AC --> U2
AC --> U3
AC --> U4
AC --> U5
AC --> U7
AC --> U8
AC --> U9
AC --> U10
AC --> U11
AC --> U12
U0 ..> U1 : <<include>>
U5 ..> U6 : <<include>>
@enduml