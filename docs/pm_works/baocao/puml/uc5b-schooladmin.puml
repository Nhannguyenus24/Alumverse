@startuml
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 15
skinparam dpi 150
skinparam shadowing false
skinparam nodesep 12
skinparam ranksep 26
skinparam wrapWidth 260
skinparam ArrowColor #4A5568
skinparam usecase {
  BackgroundColor #EAF3FB
  BorderColor #2B6CB0
  FontSize 15
}
skinparam actor {
  BackgroundColor #FFFFFF
  BorderColor #2B3A55
  FontSize 15
}
skinparam rectangle {
  BorderColor #2B3A55
  FontStyle bold
  FontSize 16
}
skinparam package {
  BackgroundColor #F7FAFC
  BorderColor #A0AEC0
  FontSize 14
  FontStyle italic
}

left to right direction
actor "Quản trị viên cấp trường" as AC
rectangle "Hệ thống AlumVerse 2026 - phạm vi toàn hệ thống" {
  package "Hạ tầng dùng chung toàn hệ thống" {
    usecase "Quản lý mẫu thư điện tử" as U0
    usecase "Quản lý kho tri thức của trợ lý ảo" as U1
    usecase "Quản lý nhà cung cấp mô hình ngôn ngữ" as U2
    usecase "Giám sát vận hành toàn hệ thống" as U3
    usecase "Tra cứu nhật ký kiểm toán" as U4
  }
}
AC --> U0
AC --> U1
AC --> U2
AC --> U3
AC --> U4
@enduml