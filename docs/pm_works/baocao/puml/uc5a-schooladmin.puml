@startuml
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 15
skinparam dpi 150
skinparam shadowing false
skinparam nodesep 12
skinparam ranksep 26
skinparam wrapWidth 260
skinparam ArrowColor #4A5568
skinparam usecase {
  BackgroundColor #EAF3FB
  BorderColor #2B6CB0
  FontSize 15
}
skinparam actor {
  BackgroundColor #FFFFFF
  BorderColor #2B3A55
  FontSize 15
}
skinparam rectangle {
  BorderColor #2B3A55
  FontStyle bold
  FontSize 16
}
skinparam package {
  BackgroundColor #F7FAFC
  BorderColor #A0AEC0
  FontSize 14
  FontStyle italic
}

left to right direction
actor "Quản trị viên cấp khoa" as PA
actor "Quản trị viên cấp trường" as AC
PA <|-- AC
rectangle "Hệ thống AlumVerse 2026 - phạm vi toàn hệ thống" {
  package "Vòng đời và cấu hình đơn vị" {
    usecase "Khởi tạo trang khoa" as U0
    usecase "Duyệt yêu cầu đăng ký tổ chức mới" as U1
    usecase "Cấu hình đường dẫn và phát hành đơn vị" as U2
    usecase "Khai báo chương trình và ngành đào tạo" as U3
    usecase "Tùy biến thương hiệu và giao diện đơn vị" as U4
    usecase "Bật tắt từng nhóm tính năng theo đơn vị" as U5
    usecase "Cấu hình quyền riêng tư của đơn vị" as U6
    usecase "Cấp và thu hồi tài khoản quản trị đơn vị" as U7
  }
}
AC --> U0
AC --> U1
AC --> U2
AC --> U3
AC --> U4
AC --> U5
AC --> U6
AC --> U7
@enduml