@startuml
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 15
skinparam dpi 150
skinparam shadowing false
skinparam nodesep 12
skinparam ranksep 26
skinparam wrapWidth 260
skinparam ArrowColor #4A5568
skinparam usecase {
  BackgroundColor #EAF3FB
  BorderColor #2B6CB0
  FontSize 15
}
skinparam actor {
  BackgroundColor #FFFFFF
  BorderColor #2B3A55
  FontSize 15
}
skinparam rectangle {
  BorderColor #2B3A55
  FontStyle bold
  FontSize 16
}
skinparam package {
  BackgroundColor #F7FAFC
  BorderColor #A0AEC0
  FontSize 14
  FontStyle italic
}

left to right direction
actor "Quản trị viên cấp khoa" as AC
rectangle "Hệ thống AlumVerse 2026 - phạm vi một đơn vị" {
  package "Người dùng, cố vấn, quỹ và khảo sát" {
    usecase "Duyệt hồ sơ người cố vấn" as U0
    usecase "Theo dõi và xử lý báo cáo buổi cố vấn" as U1
    usecase "Xác minh danh tính người dùng" as U2
    usecase "Duyệt yêu cầu cập nhật học vấn" as U3
    usecase "Quản lý tài khoản người dùng trong đơn vị" as U4
    usecase "Tạo và vận hành chiến dịch gây quỹ" as U5
    usecase "Đối soát giao dịch đóng góp" as U6
    usecase "Xem bảng điều khiển quỹ" as U7
    usecase "Tạo và phát khảo sát" as U8
    usecase "Thu thập và tổng hợp kết quả khảo sát" as U9
  }
}
AC --> U0
AC --> U1
AC --> U2
AC --> U3
AC --> U4
AC --> U5
AC --> U6
AC --> U7
AC --> U8
AC --> U9
U6 ..> U7 : <<include>>
@enduml