@startuml
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 15
skinparam dpi 150
skinparam shadowing false
skinparam nodesep 12
skinparam ranksep 26
skinparam wrapWidth 260
skinparam ArrowColor #4A5568
skinparam usecase {
  BackgroundColor #EAF3FB
  BorderColor #2B6CB0
  FontSize 15
}
skinparam actor {
  BackgroundColor #FFFFFF
  BorderColor #2B3A55
  FontSize 15
}
skinparam rectangle {
  BorderColor #2B3A55
  FontStyle bold
  FontSize 16
}
skinparam package {
  BackgroundColor #F7FAFC
  BorderColor #A0AEC0
  FontSize 14
  FontStyle italic
}

left to right direction
actor "Quản trị viên cấp khoa" as AC
rectangle "Hệ thống AlumVerse 2026 - phạm vi một đơn vị" {
  package "Kiểm duyệt nội dung và quản lý sự kiện" {
    usecase "Duyệt bài viết, tin tức và thành tích" as U0
    usecase "Quản lý chuyên mục diễn đàn" as U1
    usecase "Kiểm duyệt và điều hành chủ đề" as U2
    usecase "Kiểm duyệt tự động bằng AI" as U3
    usecase "Tạo và quản lý vòng đời sự kiện" as U4
    usecase "Điểm danh người tham dự bằng mã QR" as U5
    usecase "Gửi thư mời tham dự" as U6
    usecase "Thống kê và xuất báo cáo tham dự" as U7
    usecase "Xem bảng điều khiển thống kê của đơn vị" as U8
  }
}
AC --> U0
AC --> U1
AC --> U2
AC --> U4
AC --> U5
AC --> U6
AC --> U7
AC --> U8
U0 ..> U3 : <<extend>>
U2 ..> U3 : <<extend>>
@enduml